{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "icon": "./assets/forge-app-icon-ios.png",
    "scheme": "forge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forge.training",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.forge.training"
    },
    "web": {
      "headers": {
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F8"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/forge-rest-notification-icon.png",
          "color": "#1D252D"
        }
      ],
      "./modules/forge-rest-timer/app.plugin.js"
    ],
    "extra": {
      "eas": {
        "projectId": "6b8083d6-e0fc-4ebe-b5c9-4e38a6f7c9e0"
      }
    },
    "owner": "pristine6589"
  }
}
