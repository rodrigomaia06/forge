{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "scheme": "forge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forge.training",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.forge.training"
    },
    "web": {
      "headers": {
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F8"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.forge.training.widgets",
          "groupIdentifier": "group.com.forge.training"
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.forge.training.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.forge.training"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6b8083d6-e0fc-4ebe-b5c9-4e38a6f7c9e0"
      }
    },
    "owner": "pristine6589"
  }
}
