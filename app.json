{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "icon": "./assets/forge-app-icon-ios.png",
    "scheme": "forge",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.forge.training",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.forge.training",
      "adaptiveIcon": {
        "foregroundImage": "./assets/forge-adaptive-foreground.png",
        "backgroundColor": "#F6F7F8"
      }
    },
    "web": {
      "headers": {
        "Cross-Origin-Embedder-Policy": "credentialless",
        "Cross-Origin-Opener-Policy": "same-origin"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/forge-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F7F8"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/forge-rest-notification-icon.png",
          "color": "#1D252D",
          "sounds": ["./assets/sounds/alarm.wav"]
        }
      ],
      "./modules/forge-rest-timer/app.plugin.js",
      "./plugins/withDisableShakeToEdit.js",
      "./plugins/withForgeFileAssociation.js"
    ],
    "owner": "pristine6589"
  }
}
