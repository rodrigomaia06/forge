{
  "cli": {
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal"
    },
    "sideload": {
      "env": {
        "FORGE_IOS_SIDELOAD": "1"
      },
      "ios": {
        "withoutCredentials": true,
        "buildConfiguration": "Release"
      }
    }
  }
}
