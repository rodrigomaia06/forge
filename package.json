{
  "name": "forge-react-native",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"App.tsx\" \"index.ts\" \"playwright.config.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test:visual": "playwright test",
    "screenshots": "playwright test tests/capture-screens.spec.ts --workers=1"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "iconoir-react-native": "^7.12.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
