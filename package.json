{
  "name": "forge-react-native",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:visual",
    "format": "prettier --write \"App.tsx\" \"index.ts\" \"playwright.config.ts\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test:visual": "playwright test",
    "screenshots": "playwright test tests/e2e/visual/capture-screens.spec.ts --project=iphone-air --workers=1"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@tabler/icons-react-native": "^3.46.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.16",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-notifications": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
