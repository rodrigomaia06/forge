<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded live-countdown content view: the same header row plus the draining rail beneath,
  matching the iOS Live Activity (header + ProgressView). The rail fraction and the tints are
  driven from the module; the countdown number is system-ticked by the Chronometer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/forge_rest_card_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <ImageView
        android:id="@+id/forge_rest_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/forge_rest_stopwatch"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/forge_rest_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="7dp"
        android:text="Rest"
        android:textSize="20sp"
        android:textColor="@color/forge_rest_normal"
        android:fontFamily="@font/manrope_semibold"
        android:includeFontPadding="false" />

    <Chronometer
        android:id="@+id/forge_rest_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="34sp"
        android:textColor="@color/forge_rest_normal"
        android:fontFamily="@font/manrope_semibold"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:gravity="end" />
  </LinearLayout>

  <ProgressBar
      android:id="@+id/forge_rest_bar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="10dp"
      android:max="1000"
      android:progressDrawable="@drawable/forge_rest_progress" />
</LinearLayout>
